{
  "name": "nextassist-blog-automation",
  "version": "1.0.0",
  "description": "Pipeline multi-agente que gera e publica um post por dia no blog do NextAssist, com painel visual tipo escritório",
  "type": "module",
  "scripts": {
    "run": "tsx src/index.ts",
    "update:seo": "tsx src/scripts/update-post-seo.ts",
    "office": "tsx src/server.ts",
    "test": "node --import tsx --test src/tests.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase-admin": "^12.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^9.15.1",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
